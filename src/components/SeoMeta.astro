---
// Single source of truth for per-page SEO metadata. Layout.astro renders
// this once in <head>; pages pass title/description/etc as Layout props.
//
// Canonical URL is derived from Astro.url.pathname against the configured
// `site` in astro.config.mjs — pages don't need to think about it. Pass
// `canonical` only for the rare case (paginated views, parameterized URLs)
// where the auto-derived value is wrong.
//
// `species` picks the OG image. The Layout's small client-side snippet
// (see Layout.astro) also re-reads localStorage on the client and may
// override the meta after hydration — this prop covers the SSR / static
// case where the species context is known up front.
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  species?: "dog" | "cat";
}

const {
  title,
  description,
  image: imageProp,
  noindex = false,
  canonical,
  species,
} = Astro.props;

// Default OG image is species-aware. Cold visitors (no species in
// localStorage) get the dog variant — that's the existing behaviour. A
// cat session overrides to the cat variant. An explicit `image` prop
// always wins (it'd be set on pages like /style-pick that want their
// own artwork preview).
const speciesDefaultImage = species === "cat"
  ? "/og-default-cat.png"
  : "/og-default-dog.png";
const image = imageProp ?? speciesDefaultImage;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Purrtraits" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<slot name="jsonld" />
